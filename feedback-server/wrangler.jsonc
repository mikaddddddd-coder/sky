// Look Up feedback server: stores after-sunset answers in D1 and serves the privacy policy.
// First time: see README.md (create the database, then paste its id below).
{
  "name": "lookup-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // workers.dev is blocked in mainland China, so the app talks to this domain instead.
  "routes": [{ "pattern": "lookup.minxi.work", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lookup-feedback",
      "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create"
    }
  ]
}
