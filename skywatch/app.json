{
  "expo": {
    "name": "Look Up",
    "slug": "skywatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mikali.lookup",
      "appleTeamId": "9Q64UBUW6M",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#03040C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Look Up uses your location to work out sunset times and tonight's sky where you are."
        }
      ],
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#03040C",
          "ios": {
            "image": "./assets/opening.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TonightWidget",
              "displayName": "天色 Look Up",
              "description": "Tonight's sunset glow and tomorrow's sunrise glow",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/TonightWidget.tsx"
              }
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "scheme": "skywatch",
    "backgroundColor": "#03040C",
    "locales": {
      "zh": "./locales/zh.json",
      "en": "./locales/en.json"
    }
  }
}
